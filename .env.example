SESSION_SECRET=change-me-in-production-use-32-plus-chars
AUTH_ISSUER=http://localhost:5170/api/auth
AUTH_DCR_TOKEN=change-me-dcr-token-at-least-32-chars
AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
PUBLIC_BASE_URL=https://link.haelp.dev
# Optional: skip DCR and use a pre-created client
# AUTH_CLIENT_ID=link
# AUTH_CLIENT_SECRET=
# Coolify + Cloudflare Tunnel: real visitor IP is in this header
ADDRESS_HEADER=cf-connecting-ip
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
ORIGIN=https://link.haelp.dev
